# Model + index artifacts (see docs/DESIGN.md).
GEOINSTANT_ARTIFACTS_DIR=./artifacts
GEOINSTANT_FEEDBACK_DIR=./feedback

# Optional Claude reasoning stage: off | enrich (stream a refined answer later) | blocking
GEOINSTANT_VLM_MODE=enrich
GEOINSTANT_VLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Latency budget for the main answer (server side, ms)
GEOINSTANT_FAST_DEADLINE_MS=750

# Abuse protection. In production set both: API customers get GEOINSTANT_API_KEYS (limited per
# key); the web app gets a proxy key (limited per end user via X-Forwarded-For).
GEOINSTANT_API_KEYS=[]
GEOINSTANT_PROXY_API_KEYS=[]
GEOINSTANT_RATE_LIMIT_PER_MINUTE=20
GEOINSTANT_RATE_LIMIT_BURST=10
GEOINSTANT_CORS_ORIGINS=["http://localhost:3300"]

# coarsen = city-level precision at most when people are the main subject
GEOINSTANT_PEOPLE_PRECISION_POLICY=coarsen

# Private family album: shared secret with the web app (empty = album off)
GEOINSTANT_ARCHIVE_TOKEN=
GEOINSTANT_ARCHIVE_PEOPLE_POLICY=off

# Investigator: Claude + zoom + web search + OpenStreetMap lookup (needs ANTHROPIC_API_KEY)
GEOINSTANT_INVESTIGATOR_MODE=on
GEOINSTANT_INVESTIGATOR_EFFORT=medium
# Then & now: free token from https://www.mapillary.com/dashboard/developers
GEOINSTANT_MAPILLARY_TOKEN=
