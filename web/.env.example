# Server-side only: where the inference service lives and the proxy key it expects
# (must be listed in the service's GEOINSTANT_PROXY_API_KEYS).
INFERENCE_URL=http://localhost:8000
INFERENCE_API_KEY=

# Map style (MapLibre). OpenFreeMap needs no key; a Mapbox style URL + token also works.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
