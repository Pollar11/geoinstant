{
  "name": "geoinstant-web",
  "version": "1.0.0",
  "private": true,
  "description": "GeoInstant web client: drop a photo, see where it was taken.",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev -p 3300",
